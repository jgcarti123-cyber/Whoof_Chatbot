# Postgres — matches docker-compose.yml; also used by node-pg-migrate
DATABASE_URL=postgres://whoof:whoof@localhost:5432/whoof_vet

# Express
PORT=3000

# Set to "production" on any hosted/shared deployment. This turns on secure cookies
# and trust-proxy, and makes missing SESSION_SECRET / ADMIN_SECRET a hard startup error.
# NODE_ENV=production

# Session secret — REQUIRED when NODE_ENV=production. Use a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Admin dashboard password (/admin) — REQUIRED when NODE_ENV=production.
ADMIN_SECRET=change-me-to-a-strong-password

# Passwordless demo login at /dev-login. OFF by default (never expose it on a public
# tunnel). Set to "true" only in a trusted local .env.
# ENABLE_DEV_LOGIN=true

# LLM provider for chat answers, triage, and query rewriting.
#   groq      — open-source models via Groq (OpenAI-compatible). Needs GROQ_API_KEY.
#   anthropic — Claude. Needs ANTHROPIC_API_KEY.
LLM_PROVIDER=groq

# Groq — https://console.groq.com/keys
GROQ_API_KEY=gsk_...
# Optional overrides (defaults shown):
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_FAST_MODEL=llama-3.1-8b-instant
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Anthropic — only needed when LLM_PROVIDER=anthropic. https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ── Embeddings (RAG) ─────────────────────────────────────────────────────────
#   local  — open-source model in-process via Transformers.js. No key, no rate
#            limits. Downloads weights once (cached). DEFAULT.
#   voyage — Voyage AI API (needs VOYAGE_API_KEY; free tier is rate-limited).
EMBEDDING_PROVIDER=local
# Local model. bge-base-en-v1.5 = 768-dim (light, reliable). bge-large = 1024-dim
# (better, heavier). If you change the dimension, run a migration to match.
EMBEDDING_MODEL=Xenova/bge-base-en-v1.5

# Voyage AI — only used if EMBEDDING_PROVIDER=voyage, or ENABLE_RERANK=true.
# https://dash.voyageai.com/  (free tier: 3 RPM / 10K TPM until you add a card)
VOYAGE_API_KEY=pa-...

# Reranking — set to "true" to enable Voyage AI rerank-2 after hybrid search.
# Improves answer accuracy but adds a per-message API call (~$0.05/1000 msgs).
# Leave unset or "false" to skip reranking and use hybrid-search order directly.
ENABLE_RERANK=false

# ── Vet finder ───────────────────────────────────────────────────────────────
# Google Places API key for the "Find a vet nearby" feature.
# How to get one: https://console.cloud.google.com/
#   1. Create a project (or pick an existing one)
#   2. Go to "APIs & Services" → "Enable APIs" → search "Places API" → Enable
#   3. Go to "APIs & Services" → "Credentials" → "Create Credentials" → API key
#   4. (Recommended) Restrict the key to "Places API" under "API restrictions"
# Free tier: $200/month credit (~6,700 Nearby Search calls). More than enough.
GOOGLE_PLACES_API_KEY=AIza...

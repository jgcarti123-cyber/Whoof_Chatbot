<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Whoof Admin</title>
  <link rel="icon" type="image/png" href="/Prim_Pets.png">
  <link rel="stylesheet" href="/style.css">
  <script>(function(){var t=localStorage.getItem('whoof-theme')||(window.matchMedia('(prefers-color-scheme: light)').matches?'light':'dark');if(t==='light')document.documentElement.classList.add('light');})();</script>
</head>
<body style="display:flex;align-items:center;justify-content:center;min-height:100vh;background:var(--bg)">
  <div style="width:100%;max-width:340px;padding:1.5rem">
    <div style="display:flex;align-items:center;gap:.6rem;margin-bottom:1.8rem">
      <img src="/Prim_Pets.png" style="width:48px;height:32px;object-fit:contain">
      <span style="font-weight:700;font-size:1rem;color:var(--text)">Whoof Admin</span>
    </div>
    <% if (error) { %>
      <div class="alert alert-error" style="margin-bottom:1rem"><%= error %></div>
    <% } %>
    <form method="POST" action="/admin/login">
      <div class="field">
        <label for="secret">Admin password</label>
        <input type="password" id="secret" name="secret" autofocus autocomplete="current-password">
      </div>
      <button type="submit" class="btn btn-primary btn-full">Enter</button>
    </form>
  </div>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pet.name %> — Whoof Vet AI</title>
  <link rel="stylesheet" href="/style.css">
  <!-- marked.js for rendering markdown in AI responses -->
  <script src="https://cdn.jsdelivr.net/npm/marked@9/marked.min.js"></script>
</head>
<body class="chat-page">

  <header class="chat-header">
    <div class="chat-header-inner">
      <div class="chat-header-left">
        <span class="brand-small">🐾 Whoof</span>
        <span class="chat-pet-name">Asking about <strong><%= pet.name %></strong></span>
      </div>
      <div class="chat-header-right">
        <a href="/onboarding" class="btn btn-ghost btn-sm">Edit profile</a>
        <form method="POST" action="/logout" style="margin:0">
          <button type="submit" class="btn btn-ghost btn-sm">Log out</button>
        </form>
      </div>
    </div>
  </header>

  <div class="chat-shell">
    <aside class="chat-sidebar">
      <a href="/chat?new=1" class="new-chat-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
          <line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        New chat
      </a>
      <nav class="session-list">
        <% if (sessions && sessions.length) { %>
          <div class="session-list-label">Chats</div>
          <% sessions.forEach(function(s) { %>
            <div class="session-item <%= s.id === activeSessionId ? 'active' : '' %> <%= s.pinned ? 'pinned' : '' %>" data-id="<%= s.id %>">
              <a href="/chat?session=<%= s.id %>" class="session-link" title="<%= s.title %>"><%= s.title %></a>
              <div class="session-actions">
                <button type="button" class="session-action pin-btn" title="<%= s.pinned ? 'Unpin chat' : 'Pin chat' %>" aria-label="Pin chat">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="17" x2="12" y2="22"></line><path d="M5 17h14l-1.7-2.5a2 2 0 0 1-.3-1V5a1 1 0 0 0-1-1H8a1 1 0 0 0-1 1v8.5a2 2 0 0 1-.3 1L5 17z"></path></svg>
                </button>
                <button type="button" class="session-action delete-btn" title="Delete chat" aria-label="Delete chat">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                </button>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="session-empty">No past chats yet.</div>
        <% } %>
      </nav>
    </aside>

    <div class="chat-layout">
    <div class="messages-area" id="messages-area">

      <!-- System welcome message -->
      <div class="message ai-message">
        <div class="ai-avatar">W</div>
        <div class="bubble-wrap">
          <div class="bubble">
            Hello! I'm Whoof AI. I've reviewed <strong><%= pet.name %></strong>'s profile.
            Ask me anything about <%= pet.name %>'s health — diet questions, symptoms you're worried about,
            vaccination queries, anything at all. What's on your mind?
          </div>
          <div class="meta">Whoof Vet AI</div>
        </div>
      </div>

      <!-- Existing conversation history -->
      <% history.forEach(function(msg) { %>
        <div class="message user-message">
          <div class="bubble-wrap">
            <div class="bubble"><%= msg.owner_question %></div>
            <div class="meta"><%= new Date(msg.created_at).toLocaleString('en-IN', {dateStyle:'medium', timeStyle:'short'}) %></div>
          </div>
        </div>

        <div class="message ai-message <%= msg.escalated ? 'emergency' : '' %>">
          <div class="ai-avatar">W</div>
          <div class="bubble-wrap">
            <% if (msg.escalated) { %>
              <div class="emergency-banner">⚠️ URGENT — See a vet or emergency clinic now</div>
            <% } %>
            <div class="bubble markdown-content"><%= msg.answer_summary %></div>
            <% if (msg.sources_cited && msg.sources_cited.length) { %>
              <details class="sources">
                <summary>Sources (<%= msg.sources_cited.length %>)</summary>
                <ul>
                  <% msg.sources_cited.forEach(function(s) { %>
                    <li><strong><%= s.source %></strong><% if (s.topic) { %> — <%= s.topic %><% } %></li>
                  <% }) %>
                </ul>
              </details>
            <% } %>
            <% if (msg.confidence_level) { %>
              <div class="meta">
                <span class="confidence confidence-<%= msg.confidence_level %>"><%= msg.confidence_level %> confidence</span>
              </div>
            <% } %>
          </div>
        </div>
      <% }) %>

    </div><!-- /messages-area -->

    <div class="input-area">
      <div class="input-wrap">
        <textarea
          id="message-input"
          placeholder="Ask Whoof AI about <%= pet.name %>…"
          rows="1"
          autofocus
        ></textarea>
        <button id="send-btn" class="btn btn-primary send-btn" aria-label="Send">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="22" y1="2" x2="11" y2="13"></line>
            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
          </svg>
        </button>
      </div>
      <p class="input-disclaimer">
        Whoof AI is not a licensed vet. For emergencies, contact a vet immediately.
      </p>
    </div>
    </div><!-- /chat-layout -->
  </div><!-- /chat-shell -->

  <script>
    // Active chat id for the client (empty string = a fresh, not-yet-saved chat).
    window.__SESSION_ID__ = '<%= activeSessionId || "" %>';
  </script>
  <script src="/chat-client.js"></script>
  <script>
    // Render existing history messages as markdown
    document.querySelectorAll('.markdown-content').forEach(el => {
      el.innerHTML = marked.parse(el.textContent || '');
    });
    // Scroll to bottom on load
    const ma = document.getElementById('messages-area');
    ma.scrollTop = ma.scrollHeight;
  </script>
</body>
</html>

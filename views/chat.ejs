<!DOCTYPE html>
<html lang="en" class="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pet.name %> — Prim Pets</title>
  <link rel="icon" type="image/png" sizes="1024x1024" href="/Prim_Pets.png">
  <link rel="apple-touch-icon" href="/Prim_Pets.png">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="theme-color" content="#F4F2ED">
  <link rel="stylesheet" href="/style.css">
  <!-- Light-only reskin of the chat shell (sidebar, hero, composer). Loaded after
       style.css so it wins; message/card components keep their existing light styles. -->
  <link rel="stylesheet" href="/chat-light.css">
  <!-- marked.js renders the model's markdown; DOMPurify strips any HTML it passes
       through (marked does not sanitize) before it reaches innerHTML. Pinned versions +
       SRI hashes so a compromised/tampered CDN response can't silently swap in different
       code — the browser refuses to run the script if the hash doesn't match. -->
  <script src="https://cdn.jsdelivr.net/npm/marked@9/marked.min.js"
          integrity="sha384-odPBjvtXVM/5hOYIr3A1dB+flh0c3wAT3bSesIOqEGmyUA4JoKf/YTWy0XKOYAY7"
          crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/dompurify@3.0.9/dist/purify.min.js"
          integrity="sha384-3HPB1XT51W3gGRxAmZ+qbZwRpRlFQL632y8x+adAqCr4Wp3TaWwCLSTAJJKbyWEK"
          crossorigin="anonymous"></script>
</head>
<body class="chat-page">

  <div class="chat-shell">
    <aside class="chat-sidebar">
      <div class="sb-brand-row">
        <a href="/chat" class="sb-brand">
          <img src="/Prim_Pets.png" alt="">
          <span>Prim Pets</span>
        </a>
        <button type="button" class="sb-collapse-btn" id="sb-collapse-btn" title="Collapse sidebar" aria-label="Collapse sidebar">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="3"></rect><line x1="9" y1="3" x2="9" y2="21"></line></svg>
        </button>
      </div>

      <nav class="sb-nav">
        <a href="/chat?new=1" class="sb-item new-chat-btn">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"></circle><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
          New chat
        </a>
        <button type="button" class="sb-item" id="vet-finder-btn">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          Find nearby
        </button>
        <a href="/onboarding" class="sb-item" id="pet-profile-link">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
          Pet profile
        </a>
      </nav>

      <div class="vet-panel" id="vet-panel">
        <button type="button" class="vet-panel-head sb-item" id="vet-panel-toggle" aria-expanded="false">
          <span class="vet-panel-title">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg>
            My Vet
            <span class="vet-count" id="vet-count" <%= (pet.vets && pet.vets.length) ? '' : 'hidden' %>><%= pet.vets ? pet.vets.length : 0 %></span>
          </span>
          <svg class="vet-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </button>

        <div class="vet-panel-body" id="vet-panel-body" hidden>
          <p class="vet-panel-desc">Save your regular vet's contact, track visit dates, and generate a quick summary to bring to your next appointment.</p>
          <div class="vet-list" id="vet-list"><!-- rendered client-side from window.__VETS__ --></div>

          <button type="button" class="vet-add-btn" id="vet-add-btn">+ Add a vet</button>

          <form class="vet-form" id="vet-form" hidden>
            <input type="text" id="vet-name-input" placeholder="Vet name (e.g. Dr Sharma)" maxlength="120">
            <input type="text" id="vet-clinic-input" placeholder="Clinic name" maxlength="160">
            <input type="tel" id="vet-phone-input" placeholder="Phone (+91…)" maxlength="40">
            <div class="vet-form-actions">
              <button type="submit" class="btn btn-primary" id="vet-save-btn">Add</button>
              <button type="button" class="btn btn-ghost" id="vet-cancel-btn">Cancel</button>
            </div>
          </form>

          <div class="vet-divider"></div>

          <div class="vet-visit-row">
            <div class="vet-visit-head">
              <span class="vet-visit-label">Last vet visit</span>
              <button type="button" class="vet-link-btn" id="vet-mark-visit-btn">Set date</button>
            </div>
            <span class="vet-visit-date" id="vet-visit-date"><%= pet.last_vet_visit_date ? new Date(pet.last_vet_visit_date).toLocaleDateString('en-IN', {day:'numeric', month:'short', year:'numeric'}) : 'Not logged yet' %></span>
            <div class="vet-visit-picker" id="vet-visit-picker" hidden>
              <input type="date" id="vet-visit-input" class="vet-date-input">
              <div class="vet-form-actions">
                <button type="button" class="btn btn-primary" id="vet-visit-confirm">Confirm visit</button>
                <button type="button" class="btn btn-ghost" id="vet-visit-cancel">Cancel</button>
              </div>
              <p class="vet-visit-hint">Setting this starts a fresh “since last visit” summary from this date.</p>
            </div>
          </div>

          <div class="vet-visit-row">
            <div class="vet-visit-head">
              <span class="vet-visit-label">Next appointment</span>
              <button type="button" class="vet-link-btn" id="vet-schedule-btn"><%= pet.next_vet_visit_date ? 'Change' : 'Schedule' %></button>
            </div>
            <div class="vet-visit-head">
              <span class="vet-visit-date" id="vet-next-visit-date"><%= pet.next_vet_visit_date ? new Date(pet.next_vet_visit_date).toLocaleDateString('en-IN', {day:'numeric', month:'short', year:'numeric'}) : 'None scheduled' %></span>
              <button type="button" class="vet-link-btn" id="vet-clear-next-btn" <%= pet.next_vet_visit_date ? '' : 'hidden' %>>Clear</button>
            </div>
            <div class="vet-visit-picker" id="vet-schedule-picker" hidden>
              <input type="date" id="vet-schedule-input" class="vet-date-input">
              <div class="vet-form-actions">
                <button type="button" class="btn btn-primary" id="vet-schedule-confirm">Save date</button>
                <button type="button" class="btn btn-ghost" id="vet-schedule-cancel">Cancel</button>
              </div>
              <p class="vet-visit-hint">Keep track of your dog's upcoming appointment.</p>
            </div>
          </div>

          <div class="vet-divider"></div>

          <div class="vet-prep-block">
            <button type="button" class="vet-prep-btn" id="vet-prep-btn">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
              Prep for vet visit
            </button>
            <p class="vet-prep-caption">Prim Pets reads your recent chats and writes a short summary for your vet, plus a checklist of things to mention.</p>
            <div class="vet-range" id="vet-range" hidden>
              <button type="button" class="vet-range-opt" data-range="since_visit">Since last visit</button>
              <button type="button" class="vet-range-opt" data-range="history">Full history</button>
            </div>
          </div>
        </div>
      </div>

      <nav class="session-list">
        <% if (sessions && sessions.length) { %>
          <div class="session-list-label">Chats</div>
          <% sessions.forEach(function(s) { %>
            <div class="session-item <%= s.id === activeSessionId ? 'active' : '' %> <%= s.pinned ? 'pinned' : '' %>" data-id="<%= s.id %>">
              <a href="/chat?session=<%= s.id %>" class="session-link" title="<%= s.title %>"><%= s.title %></a>
              <div class="session-actions">
                <button type="button" class="session-action pin-btn" title="<%= s.pinned ? 'Unpin chat' : 'Pin chat' %>" aria-label="Pin chat">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="17" x2="12" y2="22"></line><path d="M5 17h14l-1.7-2.5a2 2 0 0 1-.3-1V5a1 1 0 0 0-1-1H8a1 1 0 0 0-1 1v8.5a2 2 0 0 1-.3 1L5 17z"></path></svg>
                </button>
                <button type="button" class="session-action delete-btn" title="Delete chat" aria-label="Delete chat">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                </button>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="session-empty">No past chats yet.</div>
        <% } %>
      </nav>

      <div class="sb-bottom">
        <div class="sb-pet-line" title="Answers are shaped around <%= pet.name %>'s profile">
          <span class="sb-pet-dot"></span>
          Asking about <strong><%= pet.name %></strong>
        </div>
        <form method="POST" action="/logout" style="margin:0">
          <button type="submit" class="sb-item sb-logout">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
            Log out
          </button>
        </form>
      </div>
    </aside>
    <!-- Floating reopen button — desktop: visible while collapsed; mobile: always (opens the drawer) -->
    <button type="button" class="sb-open-btn" id="sb-open-btn" title="Open sidebar" aria-label="Open sidebar">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="3"></rect><line x1="9" y1="3" x2="9" y2="21"></line></svg>
    </button>
    <!-- Mobile drawer backdrop — tap to close -->
    <div class="sb-scrim" id="sb-scrim"></div>
    <div class="sidebar-resizer" id="sidebar-resizer" title="Drag to resize" role="separator" aria-orientation="vertical"></div>

    <div class="chat-layout">
    <div class="messages-area" id="messages-area">

      <% if (!history.length) { %>
      <!-- Empty / hero state: mark, pet line, title, action pills, "Try asking" list -->
      <div class="empty-hero">
        <img class="hero-mark" src="/Prim_Pets.png" alt="">
        <div class="hero-pet-line"><%= pet.name %> · <%= pet.breed %></div>
        <h2 class="hero-title">Your Pet Concierge</h2>
        <p class="hero-sub">Prim Pets knows <%= pet.name %>'s profile, history and diet —<br>ask anything, find real places nearby, and prep for vet visits.</p>

        <div class="hero-pills">
          <button type="button" class="hero-pill hero-pill-place" data-category="vet">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg>
            Find vets nearby
          </button>
          <button type="button" class="hero-pill hero-pill-place" data-category="park">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22v-7"></path><path d="M5 8l7-6 7 6"></path><path d="M5 15l7-6 7 6"></path></svg>
            Find parks
          </button>
          <button type="button" class="hero-pill hero-pill-place" data-category="cafe">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8h1a4 4 0 0 1 0 8h-1"></path><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"></path></svg>
            Pet-friendly cafés
          </button>
          <button type="button" class="hero-pill" id="hero-briefing-btn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
            Vet visit briefing
          </button>
        </div>

        <div class="try-card">
          <div class="try-head">Try asking</div>
          <button type="button" class="try-item" data-prompt="Why is <%= pet.name %> scratching so much lately?">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
            <span>Why is <%= pet.name %> scratching so much lately?</span>
            <svg class="try-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
          <button type="button" class="try-item" data-prompt="Plan a week of healthy meals for <%= pet.name %>.">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11h16a8 8 0 0 1-8 8 8 8 0 0 1-8-8z"></path><path d="M12 4v3"></path></svg>
            <span>Plan a week of healthy meals for <%= pet.name %></span>
            <svg class="try-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
          <button type="button" class="try-item" data-prompt="Which vaccinations is <%= pet.name %> due for?">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
            <span>Which vaccinations is <%= pet.name %> due for?</span>
            <svg class="try-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
          <button type="button" class="try-item" data-prompt="What everyday foods are toxic for dogs?">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
            <span>What everyday foods are toxic for dogs?</span>
            <svg class="try-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
          <button type="button" class="try-item" data-prompt="/visualise <%= pet.name %>'s ideal daily routine">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.7 4.8L18.5 9.5l-4.8 1.7L12 16l-1.7-4.8L5.5 9.5l4.8-1.7z"></path></svg>
            <span>/visualise <%= pet.name %>'s ideal daily routine</span>
            <svg class="try-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
          <button type="button" class="try-item" data-prompt="Help me book a vet appointment for <%= pet.name %>.">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
            <span>Help me book a vet appointment for <%= pet.name %></span>
            <svg class="try-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
        </div>
      </div>
      <% } else { %>

      <!-- System welcome message -->
      <div class="message ai-message">
        <div class="ai-avatar">P</div>
        <div class="bubble-wrap">
          <div class="bubble">
            Hello! I'm Prim Pets. I've reviewed <strong><%= pet.name %></strong>'s profile.
            Ask me anything about <%= pet.name %>'s health — diet questions, symptoms you're worried about,
            vaccination queries, anything at all. What's on your mind?
          </div>
          <div class="meta">Prim Pets Vet AI</div>
        </div>
      </div>

      <!-- Existing conversation history -->
      <% history.forEach(function(msg) { %>
        <div class="message user-message">
          <div class="bubble-wrap">
            <% if (msg.reply_to_snippet) { %>
              <div class="reply-quote">↩ <%= msg.reply_to_snippet %></div>
            <% } %>
            <div class="bubble"><%= msg.owner_question %></div>
            <div class="meta"><%= new Date(msg.created_at).toLocaleString('en-IN', {dateStyle:'medium', timeStyle:'short'}) %></div>
          </div>
        </div>

        <div class="message ai-message <%= msg.escalated ? 'emergency' : '' %>" data-memory-id="<%= msg.id %>" data-answer-text="<%= msg.answer_summary || '' %>"<% if (msg.fb_rating) { %> data-feedback="<%= JSON.stringify({ rating: msg.fb_rating, tags: msg.fb_tags || [], comment: msg.fb_comment || '' }) %>"<% } %>>
          <div class="ai-avatar">P</div>
          <div class="bubble-wrap">
            <% if (msg.escalated) { %>
              <div class="emergency-banner">⚠️ URGENT — See a vet or emergency clinic now</div>
            <% } %>
            <% if (msg.structured_answer) { %>
              <div class="ai-content" data-structured="<%= JSON.stringify(msg.structured_answer) %>">
                <div class="bubble markdown-content"><%= msg.answer_summary %></div>
              </div>
            <% } else { %>
              <div class="bubble markdown-content"><%= msg.answer_summary %></div>
            <% } %>
            <% if (msg.sources_cited && msg.sources_cited.length) { %>
              <details class="sources">
                <summary>Sources (<%= msg.sources_cited.length %>)</summary>
                <ul>
                  <% msg.sources_cited.forEach(function(s) { %>
                    <% if (s.url) { %>
                      <li><a href="<%= s.url %>" target="_blank" rel="noopener"><strong><%= s.source %></strong></a> <span class="src-web">web</span></li>
                    <% } else { %>
                      <li><strong><%= s.source %></strong><% if (s.topic) { %> — <%= s.topic %><% } %></li>
                    <% } %>
                  <% }) %>
                </ul>
              </details>
            <% } %>
            <% if (msg.confidence_level) { %>
              <div class="meta">
                <span class="confidence confidence-<%= msg.confidence_level %>"><%= msg.confidence_level %> confidence</span>
              </div>
            <% } %>
            <div class="msg-actions">
              <button type="button" class="msg-reply-btn" title="Reply to this answer">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 17 4 12 9 7"></polyline><path d="M4 12h11a5 5 0 0 1 5 5v1"></path></svg>
                Reply
              </button>
            </div>
          </div>
        </div>
      <% }) %>
      <% } %>

    </div><!-- /messages-area -->

    <div class="input-area">
      <div class="input-row">
        <div class="input-wrap">
          <textarea
            id="message-input"
            placeholder="Ask anything about <%= pet.name %>…"
            rows="1"
            autofocus
          ></textarea>
          <div class="input-tools">
            <button id="send-btn" class="send-btn" aria-label="Send">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="19" x2="12" y2="5"></line><polyline points="5 12 12 5 19 12"></polyline></svg>
            </button>
          </div>
        </div><!-- /input-wrap -->
      </div><!-- /input-row -->
      <p class="input-disclaimer">
        Prim Pets AI is not a licensed vet. For emergencies, contact a vet immediately.
      </p>
    </div>
    </div><!-- /chat-layout -->
  </div><!-- /chat-shell -->

  <script>
    window.__SESSION_ID__ = <%- safeJson(activeSessionId || "") %>;
    window.__PET_NAME__ = <%- safeJson(pet.name) %>;
    window.__VETS__ = <%- safeJson(pet.vets || []) %>;
    window.__SHOW_TOUR__ = <%- safeJson(!!showTour) %>;
  </script>
  <script src="/chat-client.js"></script>
  <script>
    // Render existing history messages as markdown (sanitized — see renderMarkdown).
    document.querySelectorAll('.markdown-content').forEach(el => {
      el.innerHTML = window.renderMarkdown(el.textContent || '');
    });
    // Scroll to bottom on load
    const ma = document.getElementById('messages-area');
    ma.scrollTop = ma.scrollHeight;
  </script>
</body>
</html>

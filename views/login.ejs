<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Whoof — Vet AI Test</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="auth-page">
  <div class="auth-card">
    <div class="brand">
      <span class="brand-icon">🐾</span>
      <h1>Whoof</h1>
      <p class="brand-tagline">Vet AI — Early Access Test</p>
    </div>

    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <form method="POST" action="/login" class="auth-form">
      <div class="field">
        <label for="email">Your email</label>
        <input type="email" id="email" name="email" required
               placeholder="you@example.com" autocomplete="email">
      </div>
      <div class="field">
        <label for="access_code">Access code
          <span class="label-hint">sent to you by the Whoof team</span>
        </label>
        <input type="text" id="access_code" name="access_code" required
               placeholder="e.g. K8M2XP" autocomplete="off"
               style="letter-spacing: 0.15em; text-transform: uppercase;">
      </div>
      <button type="submit" class="btn btn-primary btn-full">Log in</button>
    </form>

    <p class="auth-help">
      Don't have a code? Contact John to be added as a tester.
    </p>
  </div>
</body>
</html>
